---
// Renders a stock photo from src/assets/stock by file name (no extension).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/stock/*.jpg', { eager: true });
interface Props { name: string; alt: string; width?: number; class?: string; loading?: 'lazy' | 'eager' }
const { name, alt, width = 900, class: cls, loading = 'lazy' } = Astro.props;
const src = files[`../assets/stock/${name}.jpg`]?.default;
if (!src) throw new Error(`Missing stock image: ${name}`);
---
<Image src={src} alt={alt} width={Math.min(width, src.width)} class={cls} loading={loading} />
