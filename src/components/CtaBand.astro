---
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Get a Free Quote Today', text = 'Call, text or send a request. Every install comes with a lifetime warranty.' } = Astro.props;
---
<section class="ctab">
  <div class="wrap ctab__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--dark" href={site.phoneHref}>Call {site.phone}</a>
      <a class="btn btn--ghost" href={site.smsHref}>Text Us</a>
      <a class="btn btn--ghost" href="/contact/#quote">Request a Quote</a>
    </div>
  </div>
</section>
<style>
  .ctab { background: var(--orange); color: var(--black); padding: clamp(48px, 7vw, 80px) 0; }
  .ctab__inner { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
  .ctab h2 { margin-bottom: 8px; }
  .ctab p { margin: 0; font-size: 1.15rem; max-width: 52ch; }
</style>
