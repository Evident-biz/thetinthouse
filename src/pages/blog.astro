---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
const posts = Object.values(import.meta.glob<any>('./blog/*.md', { eager: true }))
  .sort((a, b) => b.frontmatter.date.localeCompare(a.frontmatter.date));
---
<Base title="Window Tint Tips & Answers | The Tint House Blog" description="Straight answers about window tint, California tint law and home window film from The Tint House in Patterson, CA.">
  <PageHero eyebrow="Blog" title='Tint Tips &amp; <span class="accent">Answers</span>' lead="Straight answers from the shop." cta={false} />
  <section class="section section--cream">
    <div class="wrap posts">
      {posts.map((p) => (
        <a class="post" href={p.url}>
          <span class="post__date">{new Date(p.frontmatter.date + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          <h2>{p.frontmatter.title}</h2>
          <p>{p.frontmatter.description}</p>
          <span class="post__more">Read more →</span>
        </a>
      ))}
    </div>
  </section>
</Base>
<style>
  .posts { display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .post { background: var(--white); border-radius: var(--radius); padding: 28px; text-decoration: none; display: flex; flex-direction: column; border: 1px solid var(--gray-200); }
  .post:hover { border-color: var(--orange); }
  .post h2 { font-size: 2rem; }
  .post p { flex: 1; }
  .post__date { color: var(--gray-500); font-size: .95rem; margin-bottom: 8px; }
  .post__more { color: var(--orange-dark); font-weight: 700; }
</style>
